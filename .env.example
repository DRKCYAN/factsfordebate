# Supabase project URL — found in: Supabase Dashboard > Project Settings > API > Project URL
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co

# Supabase anon/public key — found in: Supabase Dashboard > Project Settings > API > Project API keys > anon public
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key-here

# Supabase service role key — found in: Supabase Dashboard > Project Settings > API > Project API keys > service_role
# WARNING: never expose this in client-side code — server-side only
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key-here
